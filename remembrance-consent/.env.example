# Remembrance consent kernel configuration. Copy to .env and fill in real values.
# Never commit a populated .env. Every key below is read by app/config.py
# (prefix REMEMBRANCE_).

# development | test | production. Production refuses to start with any
# ephemeral/dev key material.
REMEMBRANCE_ENV=development

# SQLAlchemy URL. The runtime login role should be a member of
# remembrance_app (created by the migration), NOT the table owner.
REMEMBRANCE_DATABASE_URL=postgresql+psycopg://remembrance_api:CHANGE_ME@127.0.0.1:5432/remembrance
# Owner/migration URL used only by `alembic upgrade head`.
REMEMBRANCE_MIGRATION_DATABASE_URL=postgresql+psycopg://remembrance_owner:CHANGE_ME@127.0.0.1:5432/remembrance

# --- Authorization tokens issued by the kernel (EdDSA / Ed25519) ---
# PEM private key. Generate: python scripts/generate_signing_key.py
REMEMBRANCE_TOKEN_SIGNING_KEY_PEM=
REMEMBRANCE_TOKEN_KEY_ID=kernel-2026-01
# JSON object {kid: public PEM} of additional verification keys (rotation).
REMEMBRANCE_TOKEN_VERIFICATION_KEYS_JSON={}
REMEMBRANCE_TOKEN_ISSUER=remembrance-consent-kernel
REMEMBRANCE_TOKEN_AUDIENCE=remembrance-downstream
# Hard-capped at 300 seconds in code.
REMEMBRANCE_TOKEN_TTL_SECONDS=300

# --- Inbound authentication (the upstream app's identity assertions) ---
# The memorial web app authenticates people and calls this service with a
# short-lived JWT: sub, email, email_verified, roles, actor_kind.
REMEMBRANCE_AUTH_JWT_ALGORITHM=HS256
# HS256: shared secret (>= 32 bytes). RS256/ES256/EdDSA: public key PEM.
REMEMBRANCE_AUTH_JWT_KEY=
REMEMBRANCE_AUTH_JWT_ISSUER=remembrance-web
REMEMBRANCE_AUTH_JWT_AUDIENCE=remembrance-consent

# --- Rate limiting for POST /consent/authorize (GCRA) ---
REMEMBRANCE_AUTHORIZE_RATE_PER_MINUTE=30
REMEMBRANCE_AUTHORIZE_BURST=10
# memory | redis
REMEMBRANCE_RATE_LIMIT_BACKEND=memory
REMEMBRANCE_REDIS_URL=redis://127.0.0.1:6379/1

# --- Object storage (voice models, audio artifacts, exports) ---
# local | s3
REMEMBRANCE_STORAGE_BACKEND=local
REMEMBRANCE_STORAGE_LOCAL_ROOT=./var/objects
REMEMBRANCE_S3_BUCKET=
REMEMBRANCE_S3_REGION=
REMEMBRANCE_S3_ENDPOINT_URL=
# Public base URL of this service, used for local-storage signed download links.
REMEMBRANCE_PUBLIC_BASE_URL=http://127.0.0.1:8790
# HMAC secret (>= 32 bytes) for local signed URLs.
REMEMBRANCE_URL_SIGNING_SECRET=
REMEMBRANCE_EXPORT_URL_TTL_SECONDS=900

# --- Revocation cascade worker ---
REMEMBRANCE_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# celery | inline (inline runs the cascade in-process; dev/test only)
REMEMBRANCE_CASCADE_DISPATCH=celery
REMEMBRANCE_CASCADE_STALE_AFTER_SECONDS=600
