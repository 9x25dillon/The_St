# Secrets for deploy/docker-compose.yml. Copy to stack.env (git-ignored),
# fill in, chmod 600. Generate random values with: openssl rand -hex 32
POSTGRES_PASSWORD=
REMEMBRANCE_OWNER_PASSWORD=
REMEMBRANCE_API_PASSWORD=
# python scripts/generate_signing_key.py --kid kernel-1
REMEMBRANCE_TOKEN_KEY_ID=kernel-1
REMEMBRANCE_TOKEN_SIGNING_KEY_PEM=
# Shared with the memorial web app, which signs identity assertions with it.
REMEMBRANCE_AUTH_JWT_KEY=
REMEMBRANCE_URL_SIGNING_SECRET=
# Public origin the reverse proxy serves this API on (used in export links).
REMEMBRANCE_PUBLIC_BASE_URL=https://consent.example.org
