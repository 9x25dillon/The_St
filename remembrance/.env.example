PUBLIC_URL=https://remembrance.astra-arcana.com
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=
# A real, monitored inbox that you control; this app does not send email.
SUPPORT_EMAIL=
# Pilot total stored-media budget: 1 GiB. Raise with disk and backup capacity.
MAX_MEDIA_BYTES=1073741824
# Optional: the separate consent kernel (remembrance-consent/) that alone authorizes voice actions.
# Set both or neither. The key must equal the kernel's REMEMBRANCE_AUTH_JWT_KEY (HS256, 32+ bytes).
REMEMBRANCE_CONSENT_KERNEL_URL=
REMEMBRANCE_AUTH_JWT_KEY=
