# ADD a separate site. Keep the existing Astra Arcana site intact.
# This is the HTTP bootstrap; issue HTTPS with Certbot before real accounts.
server {
    listen 80;
    server_name remembrance.astra-arcana.com;
    client_max_body_size 32m;
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite, rather than trust, any client-provided forwarded address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}
